# Server-side OpenRouter configuration (never expose the API key in Vite/client code)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Public URL of the deployed AI API, used by the GitHub Pages frontend
VITE_AI_API_URL=https://razorrecover-ai-teal.vercel.app/api/ai/recovery

# Server-side Razorpay TEST MODE credentials only
# Never put RAZORPAY_KEY_SECRET in frontend/Vite variables or source control.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
