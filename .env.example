# Server-side only. Never expose this value as VITE_ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional when the frontend is hosted separately from the API.
# Example: https://your-api-domain.example/api/ai/recovery
VITE_AI_API_URL=/api/ai/recovery

# Razorpay MCP is configured in your AI agent/server environment, not in browser code.
# RAZORPAY_API_KEY=rzp_test_...
# RAZORPAY_API_SECRET=...
